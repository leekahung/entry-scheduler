# Copy to .env. The queue lives in the spreadsheet, so GOOGLE_SHEETS_ID is
# always required; ADMIN_PASSCODE is required unless Google sign-in is on.
# Must be at least 12 characters.
ADMIN_PASSCODE=
PORT=3001

GOOGLE_SHEETS_ID=
# Blank uses the defaults: "Sign In Log" and "Staff".
GOOGLE_SHEETS_TAB=
GOOGLE_STAFF_TAB=

# Only when using a downloaded service-account key, rather than the identity
# the host already runs as. Newlines in the key are written as \n.
GOOGLE_SA_EMAIL=
GOOGLE_SA_KEY=

# Set these to sign staff in with Google; the passcode then stops being
# accepted. SESSION_SECRET must be at least 32 characters.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SESSION_SECRET=
ADMIN_EMAILS=
# Blank derives it from the request: <this host>/api/auth/callback.
OAUTH_REDIRECT_URI=

# Proxy hops to trust, e.g. 1 on Cloud Run. Leave blank anywhere the port is
# reachable directly, or callers can forge an on-network address.
TRUST_PROXY=
# "true" opens the console to any address; refuses to start without Google
# sign-in configured.
ALLOW_REMOTE_ADMIN=
